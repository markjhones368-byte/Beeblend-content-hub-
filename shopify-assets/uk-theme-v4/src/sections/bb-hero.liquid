{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<section class="bb bb-hero" id="bb-hero-{{ section.id }}">
  <div class="bb-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1800x', preload: 'metadata' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="bb-hero__glow" aria-hidden="true"></div>
  <div class="bb-hero__inner">
    <div class="bb-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="bb-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="bb-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="bb-hero__ctas">
        {%- if section.settings.btn1_label != blank -%}<a class="bb-btn bb-btn--gold" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="bb-btn bb-btn--ghost" href="{{ section.settings.btn2_link | default: '#honey-spectrum' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="bb-hero__proof" role="list" style="list-style:none;padding:0">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.show_stars -%}{% render 'bb-stars', rating: 5 %} {% endif -%}
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.show_cue -%}<span class="bb-hero__cue" aria-hidden="true">Scroll<i></i></span>{%- endif -%}
</section>
{% schema %}
{
  "name": "BB Hero",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video (recommended)" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Honey that tastes of where it's from" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Unheated, unblended honeys from Kashmir, the Himalayas and beyond. Each jar tastes of the place it came from." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop honey" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Find your honey" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" },
    { "type": "header", "content": "Details" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Single-origin · Raw · Unheated" },
    { "type": "checkbox", "id": "show_cue", "label": "Show scroll cue", "default": true }
  ],
  "blocks": [
    { "type": "proof", "name": "Proof point", "limit": 4, "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Raw & unheated" },
      { "type": "checkbox", "id": "show_stars", "label": "Show 5 stars before text", "default": false }
    ] }
  ],
  "presets": [ { "name": "BB Hero" } ]
}
{% endschema %}
