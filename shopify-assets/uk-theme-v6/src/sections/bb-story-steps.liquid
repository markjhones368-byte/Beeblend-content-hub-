{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<section class="bb bb-sec bb-sec--white">
  <div class="bb-wrap bb-story">
    <div class="bb-story__img">
      {%- if section.settings.illustration == 'hive_to_jar' -%}
        {%- assign jp = section.settings.jar_product | default: all_products['himalayan-multifloral-honey'] -%}
        <img class="bb-illus" src="{{ 'bb-hive-to-jar.svg' | asset_url }}" width="800" height="1000" loading="lazy" alt="Illustration: a bee on a flower, honeycomb dripping with honey, and a jar of {{ jp.title | split: '|' | first | strip | escape }}">
        {%- if jp.featured_media -%}
          {{ jp.featured_media.preview_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 20vw, 40vw', class: 'bb-illus__jar', alt: '' }}
        {%- endif -%}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div>
      <div class="bb-head" style="margin-bottom:0">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <ol class="bb-steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.btn_label != blank -%}<p style="margin-top:3.2rem"><a class="bb-btn bb-btn--solid" href="{{ section.settings.btn_link | default: '/pages/about-us' }}">{{ section.settings.btn_label }}</a></p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "BB Hive to jar",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "illustration", "label": "Visual", "default": "hive_to_jar", "options": [ { "value": "hive_to_jar", "label": "BeeBlend hive-to-jar illustration" }, { "value": "image", "label": "Use my image below" } ] },
    { "type": "product", "id": "jar_product", "label": "Jar shown in the illustration" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From hive to jar, nothing added" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We work with beekeepers in specific regions and keep each harvest separate." },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Read our story" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "step", "name": "Step", "limit": 5, "settings": [
    { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" } ] } ],
  "presets": [ { "name": "BB Hive to jar", "blocks": [
    { "type": "step", "settings": { "title": "Bees gather nectar", "text": "From a single dominant flower source in one region." } },
    { "type": "step", "settings": { "title": "The hive turns it into honey", "text": "Bees evaporate the moisture and cap each cell with wax." } },
    { "type": "step", "settings": { "title": "We jar it raw", "text": "Extracted and gently filtered, never heated, so the enzymes and flavour stay intact." } }
  ] } ]
}
{% endschema %}
