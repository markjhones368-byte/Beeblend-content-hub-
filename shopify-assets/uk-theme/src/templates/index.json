  "faq": {
   "type": "bb-faq",
   "blocks": {
    "q1": {
     "type": "qa",
     "settings": {
      "q": "My honey has gone thick and grainy. Is it spoiled?",
      "a": "<p>No. Raw honey naturally crystallises over time, especially in cooler weather. It's a sign it hasn't been heated. Stand the closed jar in warm (not boiling) water and stir to make it runny again.</p>"
     }
    },
    "q2": {
     "type": "qa",
     "settings": {
      "q": "What does single-origin mean?",
      "a": "<p>Each jar comes from one region and one main flower source, so every honey has its own colour, aroma and taste.</p>"
     }
    },
    "q3": {
     "type": "qa",
     "settings": {
      "q": "Is BeeBlend honey pure and raw?",
      "a": "<p>Yes. Every jar is pure honey with nothing added: no sugar, syrups or preservatives. It's extracted and gently filtered but never heated, which is why it crystallises naturally.</p>"
     }
    },
    "q4": {
     "type": "qa",
     "settings": {
      "q": "Which honey should I buy first?",
      "a": "<p>For tea and everyday use, start with <a href=\"/products/kashmiri-acacia-honey\">Kashmiri Acacia</a> or <a href=\"/products/himalayan-multifloral-honey\">Himalayan Multi-Flora</a>. For cooking, try <a href=\"/products/sesame-honey\">Black Sesame</a>. Still unsure? Read <a href=\"/pages/which-honey-should-i-choose\">which honey should I choose?</a></p>"
     }
    },
    "q5": {
     "type": "qa",
     "settings": {
      "q": "How should I store it?",
      "a": "<p>Keep the lid tight and store at room temperature, away from direct sunlight. No need to refrigerate.</p>"
     }
    },
    "q6": {
     "type": "qa",
     "settings": {
      "q": "How fast is UK delivery?",
      "a": "<p>Orders are processed within 1–2 business days (Monday–Friday). UK Standard Delivery takes 3–5 business days and is free on orders over £40 (otherwise £3.99). UK Express Delivery takes 1–2 business days (£6.99). You'll get tracking details by email once your order ships. See <a href=\"/pages/shipping-delivery\">shipping &amp; delivery</a>.</p>"
     }
    },
    "q7": {
     "type": "qa",
     "settings": {
      "q": "Do you ship outside the UK?",
      "a": "<p>Yes. International delivery takes 7–14 business days, with shipping calculated at checkout. Customs duties and taxes are paid by the recipient.</p>"
     }
    },
    "q8": {
     "type": "qa",
     "settings": {
      "q": "Can I order for gifting or in bulk?",
      "a": "<p>Yes. Visit our <a href=\"/pages/gifting\">gifting page</a> or <a href=\"/pages/contact\">contact us</a> for corporate and bulk orders.</p>"
     }
    }
   },
