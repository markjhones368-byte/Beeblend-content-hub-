  "faq": {
   "type": "bb-faq",
   "blocks": {
    "q1": {
     "type": "qa",
     "settings": {
      "q": "Can I buy single-flavour honey sachets?",
      "a": "<p>Our sachets come in the Pure Honey Collection box: 24 sachets, four of each of six honeys. Found a favourite? Every honey is also available as a full jar in our <a href=\"/collections/jar\">raw honey range</a>.</p>"
     }
    },
    "q2": {
     "type": "qa",
     "settings": {
      "q": "How much honey is in each sachet?",
      "a": "<p>Each sachet holds 10g of honey, roughly a generous teaspoon or two: about right for a cup of tea or a bowl of yoghurt.</p>"
     }
    },
    "q3": {
     "type": "qa",
     "settings": {
      "q": "Which flavours are in the box?",
      "a": "<p>Himalayan Multi, Fennel, Kashmiri Acacia, Mustard, Lychee and Ayurveda Blend (pure honey infused with ginger, turmeric, black pepper, clove and cinnamon).</p>"
     }
    },
    "q4": {
     "type": "qa",
     "settings": {
      "q": "My sachet has thickened. Is it okay?",
      "a": "<p>Yes. Raw honey crystallises naturally, especially in cool weather. Warm the sachet in your hand for a minute before opening. <a href=\"/blogs/news/why-does-honey-crystallise\">Here's why honey crystallises</a>.</p>"
     }
    },
    "q5": {
     "type": "qa",
     "settings": {
      "q": "How fast is delivery?",
      "a": "<p>Orders are dispatched within 1–2 business days (Monday–Saturday). Standard delivery across India takes 3–5 business days, and express delivery 1–2 business days.</p>"
     }
    },
    "q6": {
     "type": "qa",
     "settings": {
      "q": "Do you do bulk or corporate sachet orders?",
      "a": "<p>Yes. The box makes a lovely corporate or festive gift. See <a href=\"/pages/gifting\">gifting</a> or get in touch through our <a href=\"/pages/contact\">contact page</a>.</p>"
     }
    }
   },
