{%- liquid
  assign sid = 'ukp-' | append: section.id
  assign st = section.settings
  assign photo = false
  if st.style == 'photo' and st.image != blank
    assign photo = true
  endif
  assign tag = st.heading_tag | default: 'h1'
-%}
<style>
  #{{ sid }}{--c:{{ st.colour }};position:relative;z-index:2;background:var(--c);color:var(--uk-ink)}
  #{{ sid }}[data-ink="light"]{color:#FFF8E8}
  #{{ sid }} .ukp__in{display:grid;gap:clamp(2.4rem,4vw,6rem);align-items:end;padding-top:clamp(5.6rem,9vw,11rem);padding-bottom:clamp(5.6rem,8vw,9.6rem)}
  #{{ sid }} .ukp__in>*{min-width:0}
  @media(min-width:990px){#{{ sid }}.has-media .ukp__in{grid-template-columns:1.2fr 1fr;align-items:center}}
  #{{ sid }} .ukp__h{font-size:clamp(4.4rem,7.4vw,10.4rem);line-height:.95;letter-spacing:-.035em;margin:0;max-width:14ch}
  #{{ sid }} .ukp__text{margin-top:2.4rem;max-width:52ch;font-size:clamp(1.65rem,1.4vw,1.9rem);line-height:1.6;opacity:.88}
  #{{ sid }} .ukp__text p+p{margin-top:1rem}
  #{{ sid }} .ukp__text a{color:inherit}
  #{{ sid }} .ukp__cta{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:3.2rem}
  #{{ sid }} .ukp__cta .bb-btn{min-height:5.4rem;padding:0 3rem}
  #{{ sid }}[data-ink="light"] .bb-btn--solid{background:var(--uk-pollen);color:var(--uk-ink)}
  #{{ sid }} .ukp__ghost{border-color:currentColor;color:inherit;background:transparent}
  #{{ sid }} .ukp__arch{position:relative;aspect-ratio:4/5;width:min(100%,46rem);justify-self:end;border-radius:999px 999px 2.4rem 2.4rem;overflow:hidden;box-shadow:0 40px 80px -48px rgba(60,35,5,.5)}
  #{{ sid }} .ukp__arch img{width:100%;height:100%;object-fit:cover;animation:ukp-settle 1.6s var(--uk-ease) both}
  /* photo variant */
  #{{ sid }}.is-photo{background:#1F3A2E;color:#FFF8E8;overflow:hidden}
  #{{ sid }}.is-photo .ukp__bg{position:absolute;inset:0}
  #{{ sid }}.is-photo .ukp__bg img{width:100%;height:100%;object-fit:cover;animation:ukp-settle 1.8s var(--uk-ease) both}
  #{{ sid }}.is-photo .ukp__bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,28,22,.15) 0%,rgba(20,28,22,.35) 45%,rgba(20,28,22,.78) 100%)}
  #{{ sid }}.is-photo .ukp__in{position:relative;min-height:min(72vh,68rem)}
  #{{ sid }}.is-photo .bb-btn--solid{background:var(--uk-pollen);color:var(--uk-ink)}
  @keyframes ukp-settle{from{transform:scale(1.08)}to{transform:none}}
  #{{ sid }} .ukp__drip{position:absolute;left:0;right:0;top:calc(100% - 1px);width:100%;height:clamp(3.6rem,6vw,8.4rem);color:var(--c);pointer-events:none}
  #{{ sid }} .ukp__drip .d{transform-box:fill-box;transform-origin:50% 0;transform:scaleY(0);animation:ukp-drip 1.5s var(--uk-goo) forwards;animation-delay:calc(var(--i) * 120ms + 500ms)}
  @keyframes ukp-drip{to{transform:none}}
  @media (prefers-reduced-motion: reduce){#{{ sid }} img{animation:none!important}#{{ sid }} .ukp__drip .d{animation:none;transform:none}}
</style>
<section class="uk ukp{% if photo %} is-photo{% endif %}{% if st.image != blank and photo == false %} has-media{% endif %}" id="{{ sid }}" data-ink="{{ st.ink }}">
  {%- if photo -%}
    <div class="ukp__bg">{{ st.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}</div>
  {%- endif -%}
  <div class="uk-wrap ukp__in">
    <div>
      <{{ tag }} class="ukp__h">{{ st.heading }}</{{ tag }}>
      {%- if st.text != blank -%}<div class="ukp__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.btn1_label != blank or st.btn2_label != blank -%}
        <div class="ukp__cta">
          {%- if st.btn1_label != blank -%}<a class="bb-btn bb-btn--solid" href="{{ st.btn1_link }}">{{ st.btn1_label }}</a>{%- endif -%}
          {%- if st.btn2_label != blank -%}<a class="bb-btn ukp__ghost" href="{{ st.btn2_link }}">{{ st.btn2_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if st.image != blank and photo == false -%}
      <div class="ukp__arch">{{ st.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500, 800, 1200', sizes: '(min-width: 990px) 40vw, 90vw', alt: st.image.alt }}</div>
    {%- endif -%}
  </div>
  {%- if st.drip and photo == false -%}
  <svg class="ukp__drip" viewBox="0 0 1440 96" preserveAspectRatio="none" aria-hidden="true" focusable="false"><g fill="currentColor">
    <path d="M0 0H1440V18C1360 26 1300 14 1220 22S1080 30 1000 20 860 12 780 22 640 30 560 20 420 12 340 22 200 30 120 20 40 14 0 20Z"/>
    <g class="d" style="--i:0"><rect x="153" y="10" width="16" height="44" rx="8"/><circle cx="161" cy="54" r="11"/></g>
    <g class="d" style="--i:2"><rect x="602" y="10" width="18" height="64" rx="9"/><circle cx="611" cy="74" r="12"/></g>
    <g class="d" style="--i:1"><rect x="1062" y="10" width="16" height="36" rx="8"/><circle cx="1070" cy="46" r="10"/></g>
    <g class="d" style="--i:3"><rect x="1322" y="10" width="16" height="52" rx="8"/><circle cx="1330" cy="62" r="11"/></g>
  </g></svg>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "UK Page header",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "colour", "options": [ { "value": "colour", "label": "Honey colour" }, { "value": "photo", "label": "Full photo" } ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h1", "options": [ { "value": "h1", "label": "H1 (page title)" }, { "value": "h2", "label": "H2" } ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "colour", "label": "Background colour", "default": "#F4DE9A" },
    { "type": "select", "id": "ink", "label": "Text colour", "default": "dark", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] },
    { "type": "checkbox", "id": "drip", "label": "Honey drip edge", "default": true },
    { "type": "text", "id": "btn1_label", "label": "Primary button" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" }
  ],
  "presets": [ { "name": "UK Page header" } ]
}
{% endschema %}
