  "faq": {
   "type": "bb-faq",
   "blocks": {
    "q1": {
     "type": "qa",
     "settings": {
      "q": "My honey has gone thick and grainy. Is it spoiled?",
      "a": "<p>No. Raw honey naturally crystallises over time, especially in cooler weather. Stand the closed jar in warm (not boiling) water and stir to make it runny again.</p>"
     }
    },
    "q2": {
     "type": "qa",
     "settings": {
      "q": "What does single-origin mean?",
      "a": "<p>Each jar comes from one region and one main flower source, so every honey has its own colour, aroma and taste.</p>"
     }
    },
    "q3": {
     "type": "qa",
     "settings": {
      "q": "How should I store it?",
      "a": "<p>Keep the lid tight and store at room temperature, away from direct sunlight. No need to refrigerate.</p>"
     }
    },
    "q4": {
     "type": "qa",
     "settings": {
      "q": "How fast is delivery?",
      "a": "<p>Orders are dispatched within 1–2 business days (Monday–Saturday). Standard delivery across India takes 3–5 business days, and express delivery 1–2 business days.</p>"
     }
    },
    "q5": {
     "type": "qa",
     "settings": {
      "q": "Can I order for gifting or in bulk?",
      "a": "<p>Yes. Visit our gifting page or contact us for corporate and bulk orders.</p>"
     }
    }
   },
