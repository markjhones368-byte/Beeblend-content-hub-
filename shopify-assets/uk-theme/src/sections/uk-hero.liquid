{%- liquid
  assign first = section.blocks.first
  assign c0 = first.settings.colour | default: '#F4DE9A'
  assign ink0 = first.settings.ink | default: 'dark'
  assign sid = 'ukh-' | append: section.id
  assign words = section.settings.heading | split: ' '
-%}
<style>
  #{{ sid }}{--c:{{ c0 }};position:relative;z-index:3;background:var(--c);transition:background-color .8s var(--uk-ease),color .6s;color:var(--uk-ink)}
  #{{ sid }}[data-ink="light"]{color:#FFF8E8}
  #{{ sid }} .ukh__grid{display:grid;align-items:center;gap:clamp(2.4rem,4vw,6.4rem);min-height:min(88vh,84rem);padding-top:clamp(4rem,6vw,8rem);padding-bottom:clamp(6rem,8vw,10rem)}
  @media(min-width:990px){#{{ sid }} .ukh__grid{grid-template-columns:1.15fr 1fr}}
  #{{ sid }} .ukh__grid>*{min-width:0}
  #{{ sid }} h1{font-size:clamp(4.6rem,8.2vw,11.6rem);line-height:.94;letter-spacing:-.035em;margin:0;max-width:11ch}
  #{{ sid }} .ukh__w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
  #{{ sid }} .ukh__w>span{display:inline-block;transform:translateY(105%);animation:ukh-rise .95s var(--uk-ease) forwards;animation-delay:calc(var(--i) * 70ms + 120ms)}
  @keyframes ukh-rise{to{transform:none}}
  #{{ sid }} .ukh__text{max-width:46ch;margin-top:2.4rem;font-size:clamp(1.6rem,1.4vw,1.9rem);line-height:1.55;opacity:.86}
  #{{ sid }} .ukh__pick{display:flex;flex-wrap:wrap;gap:.8rem;margin:3.2rem 0 0;padding:0;list-style:none}
  #{{ sid }} .ukh__pick button{display:inline-flex;align-items:center;gap:.8rem;min-height:4.4rem;padding:0 1.6rem 0 1.2rem;border-radius:999px;border:1.5px solid currentColor;background:transparent;color:inherit;font:600 1.45rem/1 'Figtree',sans-serif;cursor:pointer;opacity:.78;transition:opacity .3s,background-color .3s,color .3s,border-color .3s}
  #{{ sid }} .ukh__pick button i{width:1.6rem;height:1.6rem;border-radius:50%;background:var(--dot);box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.18)}
  #{{ sid }} .ukh__pick button:hover{opacity:1}
  #{{ sid }} .ukh__pick button[aria-pressed="true"]{opacity:1;background:var(--uk-ink);border-color:var(--uk-ink);color:#fff}
  #{{ sid }}[data-ink="light"] .ukh__pick button[aria-pressed="true"]{background:#FFF8E8;border-color:#FFF8E8;color:var(--uk-ink)}
  #{{ sid }} .ukh__cta{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:3.2rem}
  #{{ sid }} .ukh__cta .bb-btn{min-height:5.6rem;padding:0 3.2rem;font-size:1.6rem}
  #{{ sid }} .ukh__ghost{border-color:currentColor;color:inherit;background:transparent}
  #{{ sid }} .ukh__ghost:hover{background:rgba(255,255,255,.22)}
  #{{ sid }}[data-ink="light"] .bb-btn--solid{background:var(--uk-pollen);color:var(--uk-ink)}
  #{{ sid }} .ukh__stage{position:relative;width:min(100%,58rem);margin:0 auto;aspect-ratio:1/1.08}
  #{{ sid }} .ukh__jar{position:absolute;inset:0;margin:0;opacity:0;visibility:hidden;transform:translateY(8%) rotate(9deg) scale(.9);transition:opacity .5s,transform .9s var(--uk-goo),visibility 0s .9s}
  #{{ sid }} .ukh__jar.is-on{opacity:1;visibility:visible;transform:none;transition:opacity .5s,transform .9s var(--uk-goo),visibility 0s}
  #{{ sid }} .ukh__jar.is-out{transform:translateY(-6%) rotate(-10deg) scale(.9)}
  #{{ sid }} .ukh__jar>a{display:block;color:inherit;text-decoration:none}
  #{{ sid }} .ukh__jar .uk-disc{width:86%;margin:0 auto}
  #{{ sid }} .ukh__jar figcaption{display:flex;justify-content:center;align-items:baseline;gap:1.2rem;margin-top:2rem;text-align:center;font-size:1.6rem}
  #{{ sid }} .ukh__jar figcaption b{font:600 2.4rem/1.1 'Fraunces',Georgia,serif;font-variation-settings:'SOFT' 100,'WONK' 1}
  #{{ sid }} .ukh__jar .uk-sticker{top:4%;right:2%}
  #{{ sid }} .ukh__load{animation:ukh-pop 1.1s var(--uk-goo) .35s both}
  @keyframes ukh-pop{from{opacity:0;transform:translateY(10%) scale(.86) rotate(6deg)}to{opacity:1;transform:none}}
  #{{ sid }} .ukh__drip{position:absolute;left:0;right:0;top:calc(100% - 1px);width:100%;height:clamp(4.4rem,7vw,10rem);color:var(--c);transition:color .8s var(--uk-ease);pointer-events:none;overflow:visible}
  #{{ sid }} .ukh__drip .d{transform-box:fill-box;transform-origin:50% 0;transform:scaleY(0);animation:ukh-drip 1.6s var(--uk-goo) forwards;animation-delay:calc(var(--i) * 120ms + 700ms)}
  @keyframes ukh-drip{to{transform:none}}
  @media(max-width:989px){
    #{{ sid }} .ukh__grid{min-height:0}
    #{{ sid }} .ukh__stage{width:min(78%,34rem);order:-1}
    #{{ sid }} .ukh__jar figcaption{flex-direction:column;align-items:center;gap:.4rem}
    #{{ sid }} .ukh__jar .uk-sticker{width:7.6rem;height:7.6rem;font-size:1.2rem}
    #{{ sid }} .ukh__jar .uk-sticker b{font-size:1.9rem}
    #{{ sid }} .ukh__pick{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-right:-2rem;padding-right:2rem}
    #{{ sid }} .ukh__pick::-webkit-scrollbar{display:none}
    #{{ sid }} .ukh__pick button{flex:none}
  }
  @media (prefers-reduced-motion: reduce){
    #{{ sid }} .ukh__w>span{transform:none;animation:none}
    #{{ sid }} .ukh__drip .d{transform:none;animation:none}
    #{{ sid }} .ukh__load{animation:none}
  }
</style>
<section class="uk ukh" id="{{ sid }}" data-ink="{{ ink0 }}">
  <div class="uk-wrap ukh__grid">
    <div class="ukh__copy">
      <h1 aria-label="{{ section.settings.heading | escape }}">
        {%- for w in words -%}<span class="ukh__w" aria-hidden="true"><span style="--i: {{ forloop.index0 }};">{{ w }}</span></span>{% unless forloop.last %}&#32;{% endunless %}{%- endfor -%}
      </h1>
      {%- if section.settings.text != blank -%}<p class="ukh__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 1 -%}
        <ul class="ukh__pick" aria-label="Choose a honey">
          {%- for block in section.blocks -%}
            {%- assign bp = block.settings.product -%}
            <li {{ block.shopify_attributes }}><button type="button" data-ukh-pick="{{ forloop.index0 }}" data-c="{{ block.settings.colour }}" data-ink="{{ block.settings.ink }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" style="--dot: {{ block.settings.colour }};"><i aria-hidden="true"></i>{{ block.settings.name | default: bp.title }}</button></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="ukh__cta">
        {%- if section.settings.btn1_label != blank -%}<a class="bb-btn bb-btn--solid" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="bb-btn ukh__ghost" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="ukh__stage ukh__load">
      {%- for block in section.blocks -%}
        {%- assign bp = block.settings.product -%}
        {%- if bp != blank -%}
        <figure class="ukh__jar{% if forloop.first %} is-on{% endif %}" data-ukh-jar="{{ forloop.index0 }}" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          <a href="{{ bp.url }}" {% unless forloop.first %}tabindex="-1"{% endunless %}>
            <div class="uk-disc">
              {%- if forloop.first -%}
                {{ bp.featured_media | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000', sizes: '(min-width: 990px) 46vw, 80vw', alt: bp.featured_media.alt | default: bp.title }}
              {%- else -%}
                {{ bp.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 46vw, 80vw', alt: bp.featured_media.alt | default: bp.title }}
              {%- endif -%}
              <span class="uk-sticker" aria-hidden="true"><span>from<b>{{ bp.price_min | money_without_trailing_zeros }}</b></span></span>
            </div>
            <figcaption><b>{{ block.settings.name | default: bp.title }}</b>{%- if block.settings.note != blank -%}<span>{{ block.settings.note }}</span>{%- endif -%}</figcaption>
          </a>
        </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <svg class="ukh__drip" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      <path d="M0 0H1440V22C1360 30 1300 18 1220 26S1080 34 1000 24 860 16 780 26 640 34 560 24 420 16 340 26 200 34 120 24 40 18 0 24Z"/>
      <g class="d" style="--i:0"><rect x="81" y="12" width="18" height="50" rx="9"/><circle cx="90" cy="62" r="12"/></g>
      <g class="d" style="--i:3"><rect x="291" y="12" width="16" height="28" rx="8"/><circle cx="299" cy="40" r="10"/></g>
      <g class="d" style="--i:1"><rect x="511" y="12" width="20" height="74" rx="10"/><circle cx="521" cy="86" r="13"/></g>
      <g class="d" style="--i:5"><rect x="751" y="12" width="16" height="38" rx="8"/><circle cx="759" cy="50" r="10"/></g>
      <g class="d" style="--i:2"><rect x="1001" y="12" width="18" height="62" rx="9"/><circle cx="1010" cy="74" r="12"/></g>
      <g class="d" style="--i:6"><rect x="1222" y="12" width="16" height="32" rx="8"/><circle cx="1230" cy="44" r="10"/></g>
      <g class="d" style="--i:4"><rect x="1371" y="12" width="18" height="46" rx="9"/><circle cx="1380" cy="58" r="11"/></g>
    </g>
  </svg>
</section>
<script>
(function(){
  var root=document.getElementById('{{ sid }}'); if(!root) return;
  var picks=root.querySelectorAll('[data-ukh-pick]'), jars=root.querySelectorAll('[data-ukh-jar]'), cur=0;
  function show(i){
    i=+i; if(i===cur) return;
    var b=picks[i]; root.style.setProperty('--c', b.getAttribute('data-c')); root.setAttribute('data-ink', b.getAttribute('data-ink')||'dark');
    picks.forEach(function(p,k){ p.setAttribute('aria-pressed', k===i ? 'true':'false'); });
    jars.forEach(function(j){
      var k=+j.getAttribute('data-ukh-jar'), on=k===i, a=j.querySelector('a');
      j.classList.toggle('is-on', on); j.classList.toggle('is-out', k===cur && !on);
      if(on){ j.removeAttribute('aria-hidden'); a && a.removeAttribute('tabindex'); } else { j.setAttribute('aria-hidden','true'); a && a.setAttribute('tabindex','-1'); }
    });
    cur=i;
  }
  var fine=window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  picks.forEach(function(p){
    p.addEventListener('click',function(){ show(p.getAttribute('data-ukh-pick')); });
    p.addEventListener('focus',function(){ show(p.getAttribute('data-ukh-pick')); });
    if(fine) p.addEventListener('mouseenter',function(){ show(p.getAttribute('data-ukh-pick')); });
  });
})();
</script>
{% schema %}
{
  "name": "UK Hero (honey picker)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Raw honey that tastes of where it's from" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop raw honey" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "honey", "name": "Honey", "limit": 8, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "name", "label": "Short name" },
      { "type": "text", "id": "note", "label": "One-line taste note" },
      { "type": "color", "id": "colour", "label": "Honey colour", "default": "#F4DE9A" },
      { "type": "select", "id": "ink", "label": "Text colour on this honey", "default": "dark", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] }
    ] }
  ],
  "presets": [ { "name": "UK Hero (honey picker)" } ]
}
{% endschema %}
