{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<style>
  #bb-spec-{{ section.id }} .bb-spec__top{position:relative;width:min(100%,26rem);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 50% 60%,#fff 0%,rgba(255,255,255,0) 70%);display:grid;place-items:center;margin-bottom:.8rem}
  #bb-spec-{{ section.id }} .bb-spec__jar{width:86%;height:86%;object-fit:contain;filter:drop-shadow(0 22px 26px rgba(36,33,28,.2))}
  #bb-spec-{{ section.id }} .bb-spec__top .bb-spec__swatch{position:absolute;right:6%;bottom:8%;width:4.4rem;height:4.4rem;border:3px solid #fff}
  @media(max-width:989px){#bb-spec-{{ section.id }} .bb-spec__top{width:20rem}}
</style>
<section class="bb bb-sec bb-sec--paper" id="bb-spec-{{ section.id }}"><span id="honey-spectrum" style="position:relative;top:-80px;display:block"></span>
  <div class="bb-wrap">
    <div class="bb-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="bb-spec">
      <div class="bb-spec__bars" role="tablist" aria-label="Honeys by colour">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- assign label = block.settings.name | default: p.title | split: '|' | first | strip -%}
          <button class="bb-spec__bar" role="tab" type="button" id="bb-tab-{{ block.id }}" aria-controls="bb-panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            style="--c: {{ block.settings.colour }};" {{ block.shopify_attributes }}>
            <span>{{ label }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- assign label = block.settings.name | default: p.title | split: '|' | first | strip -%}
          <div class="bb-spec__panel" role="tabpanel" id="bb-panel-{{ block.id }}" aria-labelledby="bb-tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
            <div class="bb-spec__top">
              {%- if p.featured_media -%}
                {{ p.featured_media.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 20vw, 45vw', class: 'bb-spec__jar', alt: label }}
              {%- endif -%}
              <span class="bb-spec__swatch" style="--c: {{ block.settings.colour }};" aria-hidden="true"></span>
            </div>
            <h3>{{ label }}</h3>
            <dl>
              {%- if block.settings.origin != blank -%}<dt>Origin</dt><dd>{{ block.settings.origin }}</dd>{%- endif -%}
              {%- if block.settings.taste != blank -%}<dt>Tastes of</dt><dd>{{ block.settings.taste }}</dd>{%- endif -%}
              {%- if block.settings.pairs != blank -%}<dt>Try it with</dt><dd>{{ block.settings.pairs }}</dd>{%- endif -%}
            </dl>
            {%- if p != blank -%}
              <div class="bb-price">{% if p.price_varies %}From {% endif %}{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</div>
              <div><a class="bb-btn bb-btn--solid" href="{{ p.url }}">{% if p.available %}Shop {{ label }}{% else %}View {{ label }}{% endif %}</a></div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  var root = document.getElementById('bb-spec-{{ section.id }}'); if (!root) return;
  var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]'));
  function pick(t, focus) {
    tabs.forEach(function (x) {
      var on = x === t; x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
    });
    if (focus) t.focus();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { pick(t); });
    t.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); pick(tabs[(i + 1) % tabs.length], true); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); pick(tabs[(i - 1 + tabs.length) % tabs.length], true); }
    });
  });
})();
</script>
{% schema %}
{
  "name": "BB Honey spectrum",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every honey has its own colour, and its own taste" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Lighter honeys are delicate and floral. Darker ones are deep and earthy. Tap a colour to meet the honey." }
  ],
  "blocks": [
    { "type": "honey", "name": "Honey", "limit": 8, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "name", "label": "Display name (optional)" },
      { "type": "color", "id": "colour", "label": "Honey colour", "default": "#E9B949" },
      { "type": "text", "id": "origin", "label": "Origin" },
      { "type": "text", "id": "taste", "label": "Taste notes", "default": "Light, floral, gently sweet" },
      { "type": "text", "id": "pairs", "label": "Pairs with", "default": "Tea, yoghurt, morning toast" }
    ] }
  ],
  "presets": [ { "name": "BB Honey spectrum", "blocks": [ { "type": "honey" } ] } ]
}
{% endschema %}
