{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product | default: all_products['pure-honey-collection']
  assign v = p.selected_or_first_available_variant
  assign layout = section.settings.layout | default: 'spotlight'
  assign dark = false
  if section.settings.bg == 'forest'
    assign dark = true
  endif
  assign sid = 'bb-fp-' | append: section.id
  assign save = 0
  if v.compare_at_price > v.price
    assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
  endif
-%}
<style>
  #{{ sid }}{--fp-ink:{% if dark %}#F4F1E8{% else %}var(--bb-ink){% endif %};--fp-muted:{% if dark %}rgba(244,241,232,.72){% else %}var(--bb-muted){% endif %};--fp-line:{% if dark %}rgba(255,255,255,.14){% else %}var(--bb-line){% endif %}}
  #{{ sid }} .fp__eyebrow{display:flex;align-items:center;gap:1rem;font:600 1.2rem/1 'Figtree',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--bb-gold);margin:0 0 1.4rem}
  #{{ sid }} .fp__eyebrow::before{content:"";width:2.8rem;height:1px;background:currentColor}
  #{{ sid }} .fp__now{font:700 3rem/1 'Figtree',sans-serif;color:var(--fp-ink)}
  #{{ sid }} .fp__was{font-size:1.7rem;color:var(--fp-muted);text-decoration:line-through}
  #{{ sid }} .fp__save{font:700 1.15rem/1 'Figtree',sans-serif;letter-spacing:.06em;text-transform:uppercase;padding:.6rem 1rem;border-radius:999px;background:#F6EAD0;color:#8A5F0C}
  #{{ sid }} .fp__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:.6rem 1.2rem}
  #{{ sid }} form{margin:0}

  /* ---------- Spotlight (compact card) ---------- */
  #{{ sid }}.fp-sec{padding:clamp(4.8rem,6vw,8rem) 0}
  #{{ sid }} .sp{display:grid;background:#1F3A2E;border-radius:2.8rem;overflow:hidden;box-shadow:0 40px 80px -48px rgba(31,58,46,.55);color:#F4F1E8}
  @media(min-width:990px){#{{ sid }} .sp{grid-template-columns:1.22fr 1fr}}
  #{{ sid }} .sp__media{position:relative;background:#BF9872;min-height:100%;aspect-ratio:3/2}
  @media(min-width:990px){#{{ sid }} .sp__media{aspect-ratio:auto;min-height:50rem}}
  #{{ sid }} .sp__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  #{{ sid }} .sp:hover .sp__media img{transform:scale(1.025)}
  #{{ sid }} .sp__badge{position:absolute;top:2rem;left:2rem;z-index:2;background:#C9921B;color:#1d1606;font:700 1.1rem/1 'Figtree',sans-serif;letter-spacing:.16em;text-transform:uppercase;padding:.8rem 1.3rem;border-radius:999px}
  #{{ sid }} .sp__copy{padding:clamp(3.2rem,4.4vw,5.6rem);display:flex;flex-direction:column;justify-content:center}
  #{{ sid }} .sp h2{font-family:'Young Serif',Georgia,serif;font-weight:400;font-size:clamp(3rem,3.1vw,4.4rem);line-height:1.08;color:#F4F1E8;margin:0}
  #{{ sid }} .sp__text{color:rgba(244,241,232,.76);font-size:1.6rem;line-height:1.6;margin:1.4rem 0 0;max-width:46rem}
  #{{ sid }} .sp__flav{display:flex;align-items:center;gap:1.2rem;margin:2.2rem 0 0}
  #{{ sid }} .sp__dots{display:flex;flex:none;padding:0;margin:0;list-style:none}
  #{{ sid }} .sp__dots li{width:2.2rem;height:2.2rem;border-radius:50%;background:var(--c);border:2px solid #1F3A2E}
  #{{ sid }} .sp__dots li + li{margin-left:-.6rem}
  #{{ sid }} .sp__flav p{margin:0;font-size:1.35rem;line-height:1.45;color:rgba(244,241,232,.72)}
  #{{ sid }} .sp__flav b{color:#F4F1E8;font-weight:600}
  #{{ sid }} .sp__specs{display:flex;flex-wrap:wrap;gap:.8rem;margin:1.8rem 0 0;padding:0;list-style:none}
  #{{ sid }} .sp__specs li{font:600 1.2rem/1 'Figtree',sans-serif;letter-spacing:.04em;color:#F4F1E8;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:.8rem 1.2rem}
  #{{ sid }} .sp__buy{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.6rem 2rem;margin-top:2.8rem;padding-top:2.4rem;border-top:1px solid rgba(255,255,255,.14)}
  #{{ sid }} .sp .fp__now,#{{ sid }} .sp .fp__was{color:#F4F1E8}
  #{{ sid }} .sp .fp__was{opacity:.6}
  #{{ sid }} .sp .fp__save{background:rgba(201,146,27,.22);color:#F2C35B}
  #{{ sid }} .sp__cta{display:flex;align-items:center;gap:1.8rem;flex-wrap:wrap}
  #{{ sid }} .sp__cta .bb-btn{min-height:5.2rem;padding:0 3rem;font-size:1.55rem}
  #{{ sid }} .sp__link{color:#F4F1E8;font:600 1.45rem/1 'Figtree',sans-serif;text-decoration:none;border-bottom:1px solid rgba(244,241,232,.4);padding-bottom:.3rem;white-space:nowrap}
  #{{ sid }} .sp__link:hover{border-color:#C9921B;color:#F2C35B}
  #{{ sid }} .sp__trust{display:flex;flex-wrap:wrap;gap:.6rem 1.8rem;margin:2rem 0 0;padding:0;list-style:none;font-size:1.3rem;color:rgba(244,241,232,.7)}
  #{{ sid }} .sp__trust li{display:flex;align-items:center;gap:.6rem}
  #{{ sid }} .sp__trust svg{width:1.4rem;height:1.4rem;color:#C9921B;flex:none}
  @media(max-width:749px){
    #{{ sid }} .sp{border-radius:2rem}
    #{{ sid }} .sp__copy{padding:2.8rem 2.2rem 3.2rem}
    #{{ sid }} .sp__badge{top:1.4rem;left:1.4rem}
    #{{ sid }} .sp__buy{flex-direction:column;align-items:stretch}
    #{{ sid }} .sp__cta{flex-direction:column;align-items:stretch;text-align:center}
    #{{ sid }} .sp__cta form,#{{ sid }} .sp__cta .bb-btn{width:100%}
    #{{ sid }} .sp__link{align-self:center}
    #{{ sid }} .sp__flav{flex-direction:column;align-items:flex-start;gap:1rem}
    #{{ sid }} .sp__text{font-size:1.55rem}
  }

  /* ---------- Gallery (product pages, gifting, sachets) ---------- */
  #{{ sid }} .fp{display:grid;gap:4rem;align-items:center}
  @media(min-width:990px){#{{ sid }} .fp{grid-template-columns:minmax(0,56rem) 1fr;gap:6.4rem;justify-content:center}}
  #{{ sid }} .fp__stage{position:relative;aspect-ratio:1/1;border-radius:2rem;overflow:hidden;background:#EFE6D6;box-shadow:0 30px 60px -36px rgba(90,60,16,.35)}
  #{{ sid }} .fp__stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .5s ease}
  #{{ sid }} .fp__stage img.is-on{opacity:1}
  #{{ sid }} .fp__new{position:absolute;top:1.6rem;left:1.6rem;z-index:2;background:var(--bb-gold);color:#1d1606;font:700 1.1rem/1 'Figtree',sans-serif;letter-spacing:.16em;text-transform:uppercase;padding:.8rem 1.3rem;border-radius:999px}
  #{{ sid }} .fp__thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem;margin-top:1.2rem}
  #{{ sid }} .fp__thumb{aspect-ratio:1/1;border-radius:.8rem;overflow:hidden;border:2px solid transparent;padding:0;background:none;cursor:pointer;opacity:.6;transition:opacity .3s,border-color .3s}
  #{{ sid }} .fp__thumb img{width:100%;height:100%;object-fit:cover;display:block}
  #{{ sid }} .fp__thumb[aria-current="true"]{opacity:1;border-color:var(--bb-gold)}
  #{{ sid }} .fp h2{font-family:'Young Serif',Georgia,serif;font-weight:400;font-size:clamp(3rem,3.4vw,4.6rem);line-height:1.08;color:var(--fp-ink);margin:0}
  #{{ sid }} .fp__text{color:var(--fp-muted);font-size:1.7rem;line-height:1.6;margin:1.6rem 0 0;max-width:50rem}
  #{{ sid }} .fp__chips{display:flex;flex-wrap:wrap;gap:.8rem;margin:2.4rem 0 0;padding:0;list-style:none}
  #{{ sid }} .fp__chip{display:inline-flex;align-items:center;gap:.7rem;padding:.6rem 1.2rem .6rem .7rem;border:1px solid var(--fp-line);border-radius:999px;font:500 1.3rem/1 'Figtree',sans-serif;color:var(--fp-ink)}
  #{{ sid }} .fp__chip i{width:1.6rem;height:1.6rem;border-radius:50%;background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
  #{{ sid }} .fp__stats{display:grid;grid-template-columns:repeat(3,1fr);margin:2.8rem 0 0;border-top:1px solid var(--fp-line);border-bottom:1px solid var(--fp-line)}
  #{{ sid }} .fp__stat{padding:1.4rem 0;text-align:center}
  #{{ sid }} .fp__stat + .fp__stat{border-left:1px solid var(--fp-line)}
  #{{ sid }} .fp__stat b{display:block;font:400 2.6rem/1 'Young Serif',Georgia,serif;color:var(--fp-ink)}
  #{{ sid }} .fp__stat span{display:block;margin-top:.6rem;font:600 1.05rem/1 'Figtree',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--fp-muted)}
  #{{ sid }} .fp__buy{margin-top:2.8rem}
  #{{ sid }} .fp__actions{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:2rem}
  #{{ sid }} .fp__actions .bb-btn{min-height:5.2rem;padding:0 3rem;font-size:1.55rem}
  #{{ sid }} .fp__ghost{background:transparent;color:var(--fp-ink);border-color:var(--fp-line)}
  #{{ sid }} .fp__ghost:hover{border-color:var(--fp-ink)}
  #{{ sid }} .fp__note{margin:1.8rem 0 0;font-size:1.35rem;color:var(--fp-muted)}
  @media(max-width:749px){
    #{{ sid }} .fp{gap:2.8rem}
    #{{ sid }} .fp__actions form,#{{ sid }} .fp__actions .bb-btn{flex:1 1 100%;width:100%}
  }
</style>
{%- if p != blank -%}
{%- capture add_form -%}
  {%- form 'product', p, data-bb-quick-add: '' -%}
    <input type="hidden" name="id" value="{{ v.id }}">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="bb-btn {% if dark or layout == 'spotlight' %}bb-btn--gold{% else %}bb-btn--solid{% endif %}" {% unless v.available %}disabled{% endunless %}>{% if v.available %}{{ section.settings.btn_label }}{% else %}Sold out{% endif %}</button>
  {%- endform -%}
{%- endcapture -%}
{%- capture price -%}
  <div class="fp__price">
    <span class="fp__now">{{ v.price | money_without_trailing_zeros }}</span>
    {%- if save > 0 -%}
      <span class="fp__was">{{ v.compare_at_price | money_without_trailing_zeros }}</span>
      <span class="fp__save">Save {{ save }}%</span>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if layout == 'spotlight' -%}
<section class="bb bb-sec bb-sec--{{ section.settings.bg }} fp-sec" id="{{ sid }}">
  <div class="bb-wrap">
    <div class="sp">
      <a class="sp__media" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
        {%- if section.settings.badge != blank -%}<span class="sp__badge">{{ section.settings.badge }}</span>{%- endif -%}
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: p.title }}
        {%- elsif section.settings.asset != blank -%}
          <img src="{{ section.settings.asset | asset_url }}" width="1400" height="1249" loading="lazy" alt="{{ p.title | escape }}: the box opened, showing all six honey pouches">
        {%- else -%}
          {{ p.featured_media | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', alt: p.title }}
        {%- endif -%}
      </a>
      <div class="sp__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="fp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | default: p.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="sp__text">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="sp__flav">
            <ul class="sp__dots" aria-hidden="true">
              {%- for block in section.blocks -%}<li style="--c: {{ block.settings.colour }};" {{ block.shopify_attributes }}></li>{%- endfor -%}
            </ul>
            <p><b>{{ section.blocks.size }} flavours:</b> {% for block in section.blocks %}{{ block.settings.name }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
          </div>
        {%- endif -%}
        <ul class="sp__specs">
          {%- if section.settings.stat2_num != blank -%}<li>{{ section.settings.stat2_num }} {{ section.settings.stat2_label | downcase }}</li>{%- endif -%}
          {%- if section.settings.stat3_num != blank -%}<li>{{ section.settings.stat3_num }} {{ section.settings.stat3_label | downcase }}</li>{%- endif -%}
          {%- if section.settings.spec_extra != blank -%}<li>{{ section.settings.spec_extra }}</li>{%- endif -%}
        </ul>
        <div class="sp__buy">
          {{ price }}
          <div class="sp__cta">
            {{ add_form }}
            <a class="sp__link" href="{{ p.url }}">{{ section.settings.link_label }} →</a>
          </div>
        </div>
        {%- if section.settings.note != blank -%}
          {%- assign trust = section.settings.note | split: '·' -%}
          <ul class="sp__trust">
            {%- for t in trust -%}{%- assign tt = t | strip -%}{%- if tt == section.settings.spec_extra -%}{%- continue -%}{%- endif -%}<li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- else -%}
<section class="bb bb-sec bb-sec--{{ section.settings.bg }}" id="{{ sid }}">
  <div class="bb-wrap fp">
    <div class="fp__media">
      <div class="fp__stage">
        {%- if section.settings.badge != blank -%}<span class="fp__new">{{ section.settings.badge }}</span>{%- endif -%}
        {%- for m in p.media limit: 6 -%}
          {%- liquid
            assign cls = ''
            if forloop.first
              assign cls = 'is-on'
            endif
            assign alt = m.alt | default: p.title
          -%}
          {{ m.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 560px, 100vw', class: cls, alt: alt, data-fp-slide: forloop.index0 }}
        {%- endfor -%}
      </div>
      {%- if p.media.size > 1 -%}
        <div class="fp__thumbs" aria-label="Product images">
          {%- for m in p.media limit: 6 -%}
            <button type="button" class="fp__thumb" data-fp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>
              {{ m.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="fp__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="fp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | default: p.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="fp__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="fp__chips" aria-label="Flavours in the box">
          {%- for block in section.blocks -%}
            <li class="fp__chip" style="--c: {{ block.settings.colour }};" {{ block.shopify_attributes }}><i aria-hidden="true"></i>{{ block.settings.name }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="fp__stats">
        <div class="fp__stat"><b>{{ section.settings.stat1_num }}</b><span>{{ section.settings.stat1_label }}</span></div>
        <div class="fp__stat"><b>{{ section.settings.stat2_num }}</b><span>{{ section.settings.stat2_label }}</span></div>
        <div class="fp__stat"><b>{{ section.settings.stat3_num }}</b><span>{{ section.settings.stat3_label }}</span></div>
      </div>
      <div class="fp__buy">{{ price }}</div>
      <div class="fp__actions">
        {{ add_form }}
        <a class="bb-btn fp__ghost" href="{{ p.url }}">{{ section.settings.link_label }}</a>
      </div>
      {%- if section.settings.note != blank -%}<p class="fp__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>
<script>
(function(){
  var root=document.getElementById('{{ sid }}'); if(!root) return;
  var slides=root.querySelectorAll('[data-fp-slide]'), thumbs=root.querySelectorAll('[data-fp-thumb]');
  thumbs.forEach(function(t){ t.addEventListener('click',function(){
    var i=t.getAttribute('data-fp-thumb');
    slides.forEach(function(s){ s.classList.toggle('is-on', s.getAttribute('data-fp-slide')===i); });
    thumbs.forEach(function(x){ x.setAttribute('aria-current', x===t ? 'true' : 'false'); });
  }); });
})();
</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "BB Hero product",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "spotlight", "options": [
      { "value": "spotlight", "label": "Spotlight card (compact, for homepage)" },
      { "value": "gallery", "label": "Gallery (all photos + details)" } ] },
    { "type": "image_picker", "id": "image", "label": "Spotlight image (optional)" },
    { "type": "text", "id": "asset", "label": "Spotlight theme image file", "default": "phc-spotlight.webp" },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "New" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The Pure Honey Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six honeys. One beautiful box." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "24 tear-open pouches, four of each honey. Taste them side by side and find your favourite." },
    { "type": "text", "id": "stat1_num", "label": "Stat 1 number", "default": "6" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Flavours" },
    { "type": "text", "id": "stat2_num", "label": "Stat 2 number", "default": "24" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Pouches" },
    { "type": "text", "id": "stat3_num", "label": "Stat 3 number", "default": "10g" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Each" },
    { "type": "text", "id": "spec_extra", "label": "Extra spec pill (spotlight)", "default": "Gift-ready box" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Add to cart" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "See what's inside" },
    { "type": "text", "id": "note", "label": "Trust points (separate with ·)", "default": "100% raw honey · No added sugar · Ships in 1–2 days" },
    { "type": "select", "id": "bg", "label": "Background", "default": "paper", "options": [
      { "value": "forest", "label": "Forest green" }, { "value": "paper", "label": "Warm paper" }, { "value": "white", "label": "White" } ] }
  ],
  "blocks": [ { "type": "flavour", "name": "Flavour", "limit": 8, "settings": [
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "color", "id": "colour", "label": "Colour", "default": "#E8B53A" } ] } ],
  "presets": [ { "name": "BB Hero product" } ]
}
{% endschema %}
