{%- assign sid = 'ukm-' | append: section.id -%}
<style>
  #{{ sid }}{background:{{ section.settings.bg }};color:{{ section.settings.fg }};overflow:hidden;position:relative;z-index:1}
  #{{ sid }} .ukm__track{display:flex;width:max-content;animation:ukm-run {{ section.settings.speed }}s linear infinite}
  #{{ sid }}:hover .ukm__track{animation-play-state:paused}
  #{{ sid }} ul{display:flex;align-items:center;margin:0;padding:clamp(1.8rem,2.4vw,2.6rem) 0;list-style:none}
  #{{ sid }} li{display:flex;align-items:center;gap:2.4rem;padding-right:2.4rem;white-space:nowrap;font:500 clamp(1.8rem,2.2vw,2.8rem)/1 'Fraunces',Georgia,serif;font-variation-settings:'SOFT' 100,'WONK' 1;letter-spacing:-.01em}
  #{{ sid }} svg{width:1.6rem;height:1.8rem;flex:none;color:{{ section.settings.accent }}}
  @keyframes ukm-run{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion: reduce){
    #{{ sid }} .ukm__track{animation:none;width:auto}
    #{{ sid }} .ukm__track ul+ul{display:none}
    #{{ sid }} ul{flex-wrap:wrap;justify-content:center;row-gap:1.2rem}
  }
</style>
{%- capture hex -%}<svg viewBox="0 0 16 18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0l8 4.5v9L8 18l-8-4.5v-9z"/></svg>{%- endcapture -%}
<div class="uk ukm" id="{{ sid }}" role="region" aria-label="Why BeeBlend">
  <div class="ukm__track">
    {%- for n in (1..2) -%}
      <ul {% if n == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- for r in (1..2) -%}<li {% if n == 1 and r == 1 %}{{ block.shopify_attributes }}{% endif %}{% if r == 2 %} aria-hidden="true"{% endif %}>{{ block.settings.text }}{{ hex }}</li>{%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "UK Marquee",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1F3A2E" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFF8E8" },
    { "type": "color", "id": "accent", "label": "Honeycomb mark", "default": "#F2C14E" },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 20, "max": 90, "step": 5, "default": 45 }
  ],
  "blocks": [ { "type": "item", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery over £40" } ] } ],
  "presets": [ { "name": "UK Marquee", "blocks": [ { "type": "item" } ] } ]
}
{% endschema %}
