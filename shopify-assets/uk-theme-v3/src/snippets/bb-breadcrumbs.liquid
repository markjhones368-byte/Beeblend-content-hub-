{%- liquid
  assign crumb_title = blank
  assign parent = nil
  case template.name
    when 'product'
      assign crumb_title = product.title | split: '|' | first | strip
      for c in product.collections
        if c.handle == 'jar' or c.handle == 'sachet'
          assign parent = c
          break
        endif
      endfor
      if parent == nil
        for c in product.collections
          if c.handle != 'all' and c.handle != 'frontpage'
            assign parent = c
            break
          endif
        endfor
      endif
    when 'collection'
      assign crumb_title = collection.title
    when 'page'
      assign crumb_title = page.title
  endcase
-%}
{%- if crumb_title != blank -%}
<nav class="bb-crumbs" aria-label="Breadcrumb"><ol>
  <li><a href="{{ routes.root_url }}">Home</a></li>
  {%- if parent -%}<li><a href="{{ parent.url }}">{{ parent.title }}</a></li>{%- endif -%}
  <li aria-current="page">{{ crumb_title }}</li>
</ol></nav>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}}
{%- if parent -%},{"@type":"ListItem","position":2,"name":{{ parent.title | json }},"item":{{ shop.url | append: parent.url | json }}}{%- endif -%}
,{"@type":"ListItem","position":{% if parent %}3{% else %}2{% endif %},"name":{{ crumb_title | json }},"item":{{ canonical_url | json }}}]}
</script>
{%- endif -%}
