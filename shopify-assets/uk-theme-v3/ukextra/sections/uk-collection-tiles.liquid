{%- liquid
  assign sid = 'ukct-' | append: section.id
  assign st = section.settings
-%}
<style>
  #{{ sid }}{background:{{ st.bg }};color:var(--uk-ink);padding:clamp(5.6rem,8vw,10.4rem) 0}
  #{{ sid }} h2{font-size:clamp(3.4rem,4.8vw,6.4rem);line-height:1;letter-spacing:-.03em;margin:0 0 clamp(3.2rem,4vw,5.6rem);max-width:16ch}
  #{{ sid }} .ukct__grid{display:grid;gap:1.6rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,30rem),1fr))}
  #{{ sid }} .ukct__tile{position:relative;display:block;aspect-ratio:{% if section.blocks.size < 3 %}5/4{% else %}4/5{% endif %};border-radius:2.8rem;overflow:hidden;color:#FFF8E8;text-decoration:none;background:#E9D9B0;isolation:isolate}
  #{{ sid }} .ukct__tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--uk-ease)}
  #{{ sid }} .ukct__tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,28,22,0) 45%,rgba(20,28,22,.72) 100%);z-index:1}
  #{{ sid }} .ukct__tile:hover img{transform:scale(1.06)}
  #{{ sid }} .ukct__cap{position:absolute;left:0;right:0;bottom:0;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:1.6rem;padding:2.8rem}
  #{{ sid }} .ukct__cap h3{font-size:clamp(2.6rem,2.6vw,3.6rem);line-height:1.02;letter-spacing:-.02em;margin:0;color:inherit}
  #{{ sid }} .ukct__cap span{display:block;margin-top:.6rem;font-size:1.45rem;opacity:.85}
  #{{ sid }} .ukct__go{flex:none;display:grid;place-items:center;width:5rem;height:5rem;border-radius:50%;background:var(--uk-pollen);color:var(--uk-ink);transition:transform .5s var(--uk-goo)}
  #{{ sid }} .ukct__go svg{width:1.8rem;height:1.8rem}
  #{{ sid }} .ukct__tile:hover .ukct__go{transform:rotate(-45deg) scale(1.08)}
</style>
<section class="uk ukct" id="{{ sid }}">
  <div class="uk-wrap">
    {%- if st.heading != blank -%}<h2>{{ st.heading }}</h2>{%- endif -%}
    <div class="ukct__grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          {%- assign img = c.image | default: c.featured_image -%}
          <a class="ukct__tile" href="{{ c.url }}" {{ block.shopify_attributes }}>
            {%- if img != blank -%}{{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '450, 700, 1000', sizes: '(min-width: 990px) 33vw, 90vw', alt: c.title }}{%- endif -%}
            <div class="ukct__cap">
              <div><h3>{{ block.settings.label | default: c.title }}</h3><span>{{ c.products_count }} {% if c.products_count == 1 %}product{% else %}products{% endif %}</span></div>
              <span class="ukct__go" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "UK Collection tiles",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our collections" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [ { "type": "tile", "name": "Collection", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "label", "label": "Name (optional)" }
  ] } ],
  "presets": [ { "name": "UK Collection tiles", "blocks": [ { "type": "tile" } ] } ]
}
{% endschema %}
