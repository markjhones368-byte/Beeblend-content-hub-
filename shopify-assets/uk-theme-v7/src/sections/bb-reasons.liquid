{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<style>
  #bb-rs-{{ section.id }} .bb-rs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}
  #bb-rs-{{ section.id }} .bb-rs__card{position:relative;display:flex;flex-direction:column;gap:1.4rem;padding:3.2rem 2.8rem;background:#fff;border:1px solid var(--bb-line);border-radius:1.6rem;overflow:hidden;transition:transform .7s var(--bb-ease-out,cubic-bezier(.16,1,.3,1)),box-shadow .7s var(--bb-ease,ease),border-color .5s}
  #bb-rs-{{ section.id }} .bb-rs__top{display:flex;justify-content:space-between;align-items:flex-start}
  #bb-rs-{{ section.id }} .bb-rs__ico{width:5.2rem;height:5.2rem;border-radius:50%;display:grid;place-items:center;background:var(--bb-gold-soft,#F6E7C1);color:var(--bb-forest)}
  #bb-rs-{{ section.id }} .bb-rs__ico svg{width:2.6rem;height:2.6rem}
  #bb-rs-{{ section.id }} .bb-rs__num{font-family:'Young Serif',Georgia,serif;font-size:4rem;line-height:1;color:transparent;-webkit-text-stroke:1px rgba(201,146,27,.55)}
  #bb-rs-{{ section.id }} .bb-rs__card h3{font-size:2.2rem;line-height:1.2;margin-top:.8rem}
  #bb-rs-{{ section.id }} .bb-rs__card p{color:var(--bb-muted);font-size:1.55rem;line-height:1.65}
  #bb-rs-{{ section.id }} .bb-rs__card::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,#F4DE9A,#C9921B);transform:scaleX(0);transform-origin:left;transition:transform .8s var(--bb-ease-io,cubic-bezier(.77,0,.18,1))}
  @media(hover:hover){
    #bb-rs-{{ section.id }} .bb-rs__card:hover{transform:translateY(-6px);box-shadow:0 26px 44px -28px rgba(31,58,46,.45);border-color:transparent}
    #bb-rs-{{ section.id }} .bb-rs__card:hover::after{transform:scaleX(1)}
  }
  #bb-rs-{{ section.id }} .bb-rs__link{margin-top:auto;padding-top:.6rem;font-weight:600;font-size:1.5rem;color:var(--bb-forest);text-decoration:none;border-bottom:1.5px solid var(--bb-gold);align-self:flex-start}
  #bb-rs-{{ section.id }} .bb-rs__cta{text-align:center;margin-top:4.8rem}
  @media(max-width:989px){#bb-rs-{{ section.id }} .bb-rs{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:749px){
    #bb-rs-{{ section.id }} .bb-rs{grid-template-columns:1fr;gap:1.2rem}
    #bb-rs-{{ section.id }} .bb-rs__card{padding:2.4rem 2rem}
    #bb-rs-{{ section.id }} .bb-rs__num{font-size:3.2rem}
  }
</style>
<section class="bb bb-sec bb-sec--{{ section.settings.bg }}" id="bb-rs-{{ section.id }}">
  <div class="bb-wrap">
    <div class="bb-head{% if section.settings.center %} bb-head--center{% endif %}">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <div class="bb-rs">
      {%- for block in section.blocks -%}
        <article class="bb-rs__card bb-card" {{ block.shopify_attributes }}>
          <div class="bb-rs__top">
            <span class="bb-rs__ico">{% render 'bb-icon', name: block.settings.icon %}</span>
            <span class="bb-rs__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank -%}<a class="bb-rs__link" href="{{ block.settings.link }}">{{ block.settings.link_label }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <div class="bb-rs__cta"><a class="bb-btn bb-btn--solid" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "BB Reasons grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why people switch to BeeBlend" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": true },
    { "type": "text", "id": "btn_label", "label": "Button" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "paper", "label": "Warm paper" }, { "value": "sage", "label": "Sage" } ] }
  ],
  "blocks": [ { "type": "reason", "name": "Reason", "limit": 9, "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
      { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "pin", "label": "Pin" }, { "value": "truck", "label": "Truck" },
      { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "hex", "label": "Honeycomb" }, { "value": "cash", "label": "Cash" } ] },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" } ] } ],
  "presets": [ { "name": "BB Reasons grid", "blocks": [ { "type": "reason" }, { "type": "reason" }, { "type": "reason" } ] } ]
}
{% endschema %}
