{%- comment -%}
  Real product jars as an editorial composition.
  3 jars = trio on a soft stage. 4-5 jars = "shelf": each jar in its own tinted arch with its name.
  Usage: render 'bb-jar-trio', products: section.settings.trio, tint: '#EFE2C8', max: 5
{%- endcomment -%}
{%- assign max_jars = max | default: 3 -%}
{%- assign n = products.count | at_most: max_jars -%}
{%- if n >= 4 -%}
  {%- assign tints = '#EFE6D2,#F7E6A6,#F5D6D9,#D5E9EC,#D3E8D5' | split: ',' -%}
  <div class="bb-shelf bb-shelf--{{ n }}" style="--n: {{ n }};" role="img" aria-label="{% for p in products limit: max_jars %}{{ p.title | split: '|' | first | strip | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}">
    {%- for p in products limit: max_jars -%}
      {%- liquid
        assign nm = p.title | split: '|' | first | strip | remove: ' Raw Honey' | remove: ' Flower Honey' | remove: ' Honey'
        assign t = tints[forloop.index0] | default: '#EFE6D2'
      -%}
      <a class="bb-shelf__item" href="{{ p.url }}" style="--t: {{ t }}; --i: {{ forloop.index0 }};" tabindex="-1">
        <span class="bb-shelf__arch">
          {%- if p.featured_media -%}
            {{ p.featured_media.preview_image | image_url: width: 500 | image_tag: loading: 'eager', widths: '200, 350, 500', sizes: '(min-width: 990px) 9vw, 18vw', class: 'bb-shelf__jar', alt: '' }}
          {%- endif -%}
        </span>
        <span class="bb-shelf__name">{{ nm }}</span>
      </a>
    {%- endfor -%}
  </div>
{%- else -%}
  <div class="bb-trio bb-trio--{{ n }}" style="--tint: {{ tint | default: '#EFE2C8' }};" aria-hidden="true">
    <span class="bb-trio__floor"></span>
    {%- for p in products limit: max_jars -%}
      {%- if p.featured_media -%}
        {{ p.featured_media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 990px) 18vw, 32vw', class: 'bb-trio__jar', alt: '' }}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
