{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<section class="bb bb-sec bb-sec--{{ section.settings.bg }}">
  <div class="bb-wrap">
    <div class="bb-head bb-head--center"><h2>{{ section.settings.heading }}</h2></div>
    <div class="bb-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.q }}</summary>
          <div class="bb-faq__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{% schema %}
{
  "name": "BB FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "paper", "label": "Warm paper" }, { "value": "sage", "label": "Sage" } ] }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "q", "label": "Question" }, { "type": "richtext", "id": "a", "label": "Answer" } ] } ],
  "presets": [ { "name": "BB FAQ", "blocks": [ { "type": "qa" } ] } ]
}
{% endschema %}
