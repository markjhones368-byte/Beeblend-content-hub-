  "faq": {
   "type": "bb-faq",
   "blocks": {
    "q1": {
     "type": "qa",
     "settings": {
      "q": "Is BeeBlend honey 100% pure?",
      "a": "<p>Yes. Our raw honeys are 100% honey, with no added sugar, artificial preservatives, colours or flavours. Golden Nut Infusion also contains almonds, cashews and dates.</p>"
     }
    },
    "q2": {
     "type": "qa",
     "settings": {
      "q": "Is it raw?",
      "a": "<p>Yes. It's unheated and minimally handled to keep its natural taste and aroma.</p>"
     }
    },
    "q3": {
     "type": "qa",
     "settings": {
      "q": "My honey has gone thick and grainy. Is it spoiled?",
      "a": "<p>No. Raw honey naturally crystallises over time, especially in cooler weather. Stand the closed jar in warm (not boiling) water and stir to make it runny again.</p>"
     }
    },
    "q4": {
     "type": "qa",
     "settings": {
      "q": "Can I use it instead of sugar?",
      "a": "<p>Yes. Use it in tea, porridge, yoghurt, dressings, baking and cooking. Honey is sweeter than sugar, so you'll need a little less.</p>"
     }
    },
    "q5": {
     "type": "qa",
     "settings": {
      "q": "How fast is UK delivery?",
      "a": "<p>Orders are processed within 1–2 business days (Monday–Friday). UK Standard Delivery takes 3–5 business days and is free on orders over £40 (otherwise £3.99). UK Express Delivery takes 1–2 business days (£6.99). You'll get tracking details by email once your order ships. See <a href=\"/pages/shipping-delivery\">shipping &amp; delivery</a>.</p>"
     }
    },
    "q6": {
     "type": "qa",
     "settings": {
      "q": "What if my jar arrives damaged?",
      "a": "<p>Email support@beeblend.co.uk within 48 hours of delivery with your order number and a photo, and we'll put it right quickly.</p>"
     }
    },
    "q7": {
     "type": "qa",
     "settings": {
      "q": "Is honey suitable for babies?",
      "a": "<p>No. Honey is not suitable for infants under 12 months.</p>"
     }
    }
   },
