{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
<style>
  #bb-rit-{{ section.id }} .bb-rit{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2.4rem}
  #bb-rit-{{ section.id }} .bb-rit__card{display:flex;flex-direction:column;gap:1.6rem;text-decoration:none;color:inherit}
  #bb-rit-{{ section.id }} .bb-rit__frame{position:relative;aspect-ratio:4/5;border-radius:1.2rem;overflow:hidden;background:var(--tint)}
  #bb-rit-{{ section.id }} .bb-rit__frame img.bb-rit__jar{position:absolute;left:50%;top:46%;width:72%;height:72%;object-fit:contain;transform:translate(-50%,-50%);transition:transform 1.4s var(--bb-ease-out,cubic-bezier(.16,1,.3,1));filter:drop-shadow(0 24px 30px rgba(36,33,28,.18))}
  #bb-rit-{{ section.id }} .bb-rit__frame video,#bb-rit-{{ section.id }} .bb-rit__frame img.bb-rit__cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--bb-ease-out,cubic-bezier(.16,1,.3,1))}
  #bb-rit-{{ section.id }} .bb-rit__num{position:absolute;top:1.8rem;left:2rem;font-family:'Marcellus',Georgia,serif;font-size:1.5rem;color:rgba(36,33,28,.55);letter-spacing:.04em}
  #bb-rit-{{ section.id }} .bb-rit__title{font-family:'Marcellus',Georgia,serif;font-size:2.2rem;line-height:1.2;margin:0}
  #bb-rit-{{ section.id }} .bb-rit__text{color:var(--bb-muted);font-size:1.5rem;line-height:1.6;margin:.6rem 0 0}
  #bb-rit-{{ section.id }} .bb-rit__link{display:inline-flex;gap:.8rem;align-items:center;margin-top:1.2rem;font-weight:600;font-size:1.4rem;color:var(--bb-forest);text-decoration:none}
  #bb-rit-{{ section.id }} .bb-rit__link span{background:linear-gradient(currentColor,currentColor) 0 100%/100% 1px no-repeat;padding-bottom:2px}
  #bb-rit-{{ section.id }} .bb-rit__link i{font-style:normal;transition:transform .6s var(--bb-ease-out,cubic-bezier(.16,1,.3,1))}
  @media(hover:hover){
    #bb-rit-{{ section.id }} .bb-rit__card:hover img.bb-rit__jar{transform:translate(-50%,-52%) scale(1.05)}
    #bb-rit-{{ section.id }} .bb-rit__card:hover img.bb-rit__cover{transform:scale(1.04)}
    #bb-rit-{{ section.id }} .bb-rit__card:hover .bb-rit__link i{transform:translateX(5px)}
  }
  @media(max-width:989px){
    #bb-rit-{{ section.id }} .bb-rit{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:72%;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -1.6rem;padding:0 1.6rem 1.2rem;scrollbar-width:none}
    #bb-rit-{{ section.id }} .bb-rit::-webkit-scrollbar{display:none}
    #bb-rit-{{ section.id }} .bb-rit__card{scroll-snap-align:start}
    #bb-rit-{{ section.id }} .bb-rit__title{font-size:2rem}
  }
</style>
<section class="bb bb-sec bb-sec--{{ section.settings.bg }}" id="bb-rit-{{ section.id }}">
  <div class="bb-wrap">
    <div class="bb-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="bb-rit">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="bb-rit__card bb-card" {{ block.shopify_attributes }}>
          <a class="bb-rit__frame" href="{{ p.url | default: '#' }}" style="--tint: {{ block.settings.tint }};" aria-label="{{ block.settings.title | escape }}">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, controls: false, preload: 'none', image_size: '720x' }}
            {%- elsif block.settings.image != blank -%}
              {%- assign rit_alt = p.title | split: '|' | first | strip | append: ', ' | append: block.settings.title -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 25vw, 72vw', class: 'bb-rit__cover', alt: rit_alt }}
            {%- elsif block.settings.asset != blank -%}
              {%- assign rit_alt = p.title | split: '|' | first | strip | append: ', ' | append: block.settings.title -%}
              <img class="bb-rit__cover" src="{{ block.settings.asset | asset_url }}" width="512" height="640" loading="lazy" alt="{{ rit_alt | escape }}">
            {%- elsif p.featured_media -%}
              {{ p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 25vw, 72vw', class: 'bb-rit__jar', alt: p.title }}
            {%- endif -%}
            {%- if block.settings.video == blank and block.settings.image == blank and block.settings.asset == blank -%}<span class="bb-rit__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>{%- endif -%}
          </a>
          <div>
            <h3 class="bb-rit__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="bb-rit__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if p != blank -%}
              <a class="bb-rit__link" href="{{ p.url }}"><span>{{ p.title | split: '|' | first | strip }}</span><i aria-hidden="true">&rarr;</i></a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function () {
  var root = document.getElementById('bb-rit-{{ section.id }}'); if (!root) return;
  var vids = root.querySelectorAll('video'); if (!vids.length) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { e.target.play().catch(function(){}); } else { e.target.pause(); } });
  }, { threshold: 0.5 });
  vids.forEach(function (v) { v.muted = true; io.observe(v); });
})();
</script>
{% schema %}
{
  "name": "BB Ways to enjoy",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four ways to enjoy it" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Simple rituals, from our kitchen to yours." },
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "paper", "label": "Warm paper" }, { "value": "sage", "label": "Sage" } ] }
  ],
  "blocks": [
    { "type": "reel", "name": "Ritual", "limit": 8, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Morning tea" },
      { "type": "textarea", "id": "text", "label": "Short description" },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "color", "id": "tint", "label": "Card background", "default": "#F3EBDD" },
      { "type": "paragraph", "content": "Optional: add a customer video or lifestyle photo to replace the jar image." },
      { "type": "video", "id": "video", "label": "Video (vertical works best)" },
      { "type": "image_picker", "id": "image", "label": "Lifestyle photo" },
      { "type": "text", "id": "asset", "label": "Theme image file (advanced)" }
    ] }
  ],
  "presets": [ { "name": "BB Ways to enjoy", "blocks": [ { "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" } ] } ]
}
{% endschema %}
