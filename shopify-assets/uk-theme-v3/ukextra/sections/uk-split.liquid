{%- liquid
  assign sid = 'uks-' | append: section.id
  assign st = section.settings
-%}
<style>
  #{{ sid }}{background:{{ st.bg }};color:var(--uk-ink);padding:clamp(5.6rem,8vw,10.4rem) 0}
  #{{ sid }}[data-ink="light"]{color:#FFF8E8}
  #{{ sid }} .uks__in{display:grid;gap:clamp(3.2rem,5vw,8rem);align-items:center}
  #{{ sid }} .uks__in>*{min-width:0}
  @media(min-width:990px){
    #{{ sid }} .uks__in{grid-template-columns:1fr 1fr}
    #{{ sid }}.is-right .uks__media{order:2}
  }
  #{{ sid }} .uks__media{position:relative;justify-self:center;width:min(100%,56rem)}
  #{{ sid }} .uks__frame{position:relative;overflow:hidden;background:rgba(255,255,255,.35)}
  #{{ sid }} .uks__frame img{width:100%;height:100%;object-fit:cover}
  #{{ sid }}[data-shape="arch"] .uks__frame{aspect-ratio:4/5;border-radius:999px 999px 2.4rem 2.4rem}
  #{{ sid }}[data-shape="rounded"] .uks__frame{border-radius:2.8rem}
  #{{ sid }}[data-shape="rounded"] .uks__frame img{height:auto}
  #{{ sid }}[data-shape="disc"] .uks__frame{aspect-ratio:1/1;border-radius:50%;background:radial-gradient(circle at 50% 38%,#fff 0%,#FFF8E6 62%,#F5E6BF 100%)}
  #{{ sid }}[data-shape="disc"] .uks__frame img{object-fit:contain;padding:9%}
  #{{ sid }} .uks__copy{max-width:56rem}
  #{{ sid }} .uks__cap{font-weight:600;font-size:1.5rem;margin-bottom:1.4rem;opacity:.75}
  #{{ sid }} h2{font-size:clamp(3.4rem,4.6vw,6rem);line-height:1;letter-spacing:-.03em;margin:0}
  #{{ sid }} .uks__text{margin-top:2.2rem;font-size:clamp(1.6rem,1.3vw,1.8rem);line-height:1.65;opacity:.9}
  #{{ sid }} .uks__text p+p,#{{ sid }} .uks__text ul,#{{ sid }} .uks__text ol{margin-top:1.2rem}
  #{{ sid }} .uks__text a{color:inherit}
  #{{ sid }} .uks__text h2,#{{ sid }} .uks__text h3,#{{ sid }} .uks__text h4{font-size:clamp(2.2rem,1.9vw,2.6rem);line-height:1.15;letter-spacing:-.01em;margin:2.8rem 0 .6rem}
  #{{ sid }} .uks__text>h2:first-child,#{{ sid }} .uks__text>h3:first-child{margin-top:0}
  #{{ sid }} .uks__cta{margin-top:3.2rem;display:flex;flex-wrap:wrap;gap:1.2rem}
  #{{ sid }}[data-ink="light"] .bb-btn--solid{background:var(--uk-pollen);color:var(--uk-ink)}
  .uk-js #{{ sid }} .uks__frame{clip-path:inset(100% 0 0 0 round 2.4rem);transition:clip-path 1.2s var(--uk-ease)}
  .uk-js #{{ sid }} .uks__frame img{transform:scale(1.12);transition:transform 1.6s var(--uk-ease)}
  .uk-js #{{ sid }}.is-in .uks__frame{clip-path:inset(0 0 0 0 round 0)}
  .uk-js #{{ sid }}.is-in .uks__frame img{transform:none}
  @media (prefers-reduced-motion: reduce){.uk-js #{{ sid }} .uks__frame{clip-path:none}.uk-js #{{ sid }} .uks__frame img{transform:none}}
</style>
<section class="uk uks{% if st.image_side == 'right' %} is-right{% endif %}" id="{{ sid }}" data-shape="{{ st.shape }}" data-ink="{{ st.ink }}" data-uk-reveal>
  <div class="uk-wrap uks__in">
    {%- if st.image != blank -%}
      <div class="uks__media"><div class="uks__frame">{{ st.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 46vw, 92vw', alt: st.image.alt }}</div></div>
    {%- endif -%}
    <div class="uks__copy">
      {%- if st.caption != blank -%}<p class="uks__cap">{{ st.caption }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2>{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="uks__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.btn_label != blank -%}<div class="uks__cta"><a class="bb-btn bb-btn--solid" href="{{ st.btn_link }}">{{ st.btn_label }}</a></div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "UK Image and text",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "shape", "label": "Image shape", "default": "arch", "options": [ { "value": "arch", "label": "Arch" }, { "value": "rounded", "label": "Rounded" }, { "value": "disc", "label": "Disc (for jars)" } ] },
    { "type": "select", "id": "image_side", "label": "Image side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "select", "id": "ink", "label": "Text colour", "default": "dark", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] },
    { "type": "text", "id": "caption", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [ { "name": "UK Image and text" } ]
}
{% endschema %}
