{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign n_links = 0
  if section.settings.instagram != blank
    assign n_links = n_links | plus: 1
  endif
  if section.settings.tiktok != blank
    assign n_links = n_links | plus: 1
  endif
  if section.settings.youtube != blank
    assign n_links = n_links | plus: 1
  endif
  if section.settings.facebook != blank
    assign n_links = n_links | plus: 1
  endif
-%}
<style>
  #bb-soc-{{ section.id }} .bb-soc__links{display:grid;grid-template-columns:repeat({{ n_links | at_least: 1 }},minmax(0,1fr));gap:1.6rem;margin-bottom:{% if section.blocks.size > 0 %}5.6rem{% else %}0{% endif %}}
  #bb-soc-{{ section.id }} .bb-soc__link{--brand:#1F3A2E;position:relative;display:flex;flex-direction:column;gap:2.4rem;padding:3.2rem 2.8rem 2.8rem;border:1px solid var(--bb-line);border-radius:1.2rem;background:#fff;color:var(--bb-ink);text-decoration:none;overflow:hidden;isolation:isolate;transition:color .6s var(--bb-ease,ease),border-color .6s var(--bb-ease,ease),transform .6s var(--bb-ease-out,ease),box-shadow .6s var(--bb-ease,ease)}
  #bb-soc-{{ section.id }} .bb-soc__link--ig{--brand:linear-gradient(45deg,#FEDA75 0%,#FA7E1E 25%,#D62976 50%,#962FBF 75%,#4F5BD5 100%);--glow:rgba(214,41,118,.35)}
  #bb-soc-{{ section.id }} .bb-soc__link--yt{--brand:#FF0000;--glow:rgba(255,0,0,.3)}
  #bb-soc-{{ section.id }} .bb-soc__link--tt{--brand:#111;--glow:rgba(0,0,0,.3)}
  #bb-soc-{{ section.id }} .bb-soc__link--fb{--brand:#1877F2;--glow:rgba(24,119,242,.32)}
  #bb-soc-{{ section.id }} .bb-soc__link::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--brand);transform:scaleY(0);transform-origin:bottom;transition:transform .7s var(--bb-ease-io,cubic-bezier(.77,0,.18,1))}
  #bb-soc-{{ section.id }} .bb-soc__link::after{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--brand)}
  #bb-soc-{{ section.id }} .bb-logo{width:4rem;height:4rem;display:block}
  #bb-soc-{{ section.id }} .bb-logo *{transition:fill .5s var(--bb-ease,ease)}
  #bb-soc-{{ section.id }} .bb-soc__name{font-family:'Young Serif',Georgia,serif;font-size:2.4rem;line-height:1.1}
  #bb-soc-{{ section.id }} .bb-soc__handle{color:var(--bb-muted);font-size:1.45rem;margin-top:.4rem;transition:color .6s}
  #bb-soc-{{ section.id }} .bb-soc__cta{display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:1.4rem;border-top:1px solid var(--bb-line);padding-top:1.6rem;transition:border-color .6s}
  #bb-soc-{{ section.id }} .bb-soc__cta i{font-style:normal;transition:transform .6s var(--bb-ease-out,ease)}
  @media(hover:hover){
    #bb-soc-{{ section.id }} .bb-soc__link:hover{color:#fff;border-color:transparent;transform:translateY(-4px);box-shadow:0 22px 40px -22px var(--glow)}
    #bb-soc-{{ section.id }} .bb-soc__link:hover::before{transform:scaleY(1);transform-origin:top}
    #bb-soc-{{ section.id }} .bb-soc__link:hover .bb-soc__handle{color:rgba(255,255,255,.85)}
    #bb-soc-{{ section.id }} .bb-soc__link:hover .bb-soc__cta{border-color:rgba(255,255,255,.3)}
    #bb-soc-{{ section.id }} .bb-soc__link:hover .bb-soc__cta i{transform:translateX(5px)}
    #bb-soc-{{ section.id }} .bb-soc__link--ig:hover .bb-logo__fill{fill:#fff}
    #bb-soc-{{ section.id }} .bb-soc__link--yt:hover .bb-logo__fill,#bb-soc-{{ section.id }} .bb-soc__link--fb:hover .bb-logo__fill{fill:#fff}
    #bb-soc-{{ section.id }} .bb-soc__link--yt:hover .bb-logo__mark{fill:#FF0000}
    #bb-soc-{{ section.id }} .bb-soc__link--fb:hover .bb-logo__mark{fill:#1877F2}
    #bb-soc-{{ section.id }} .bb-soc__link--tt:hover .bb-logo__fill{fill:#fff}
  }
  #bb-soc-{{ section.id }} .bb-soc__feedhead{display:flex;justify-content:space-between;align-items:baseline;gap:2rem;margin-bottom:2rem}
  #bb-soc-{{ section.id }} .bb-soc__feedhead h3{font-size:2.4rem}
  #bb-soc-{{ section.id }} .bb-soc__feedhead a{color:var(--bb-forest);font-weight:600;font-size:1.4rem;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}
  #bb-soc-{{ section.id }} .bb-soc__grid{display:grid;grid-template-columns:repeat(var(--n,3),minmax(0,1fr));gap:1.2rem}
  #bb-soc-{{ section.id }} .bb-soc__tile{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:.8rem;background:var(--bb-paper);display:block}
  #bb-soc-{{ section.id }} .bb-soc__tile img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--bb-ease-out,ease)}
  #bb-soc-{{ section.id }} .bb-soc__tile::after{content:"";position:absolute;inset:0;background:rgba(31,58,46,.55);opacity:0;transition:opacity .5s}
  #bb-soc-{{ section.id }} .bb-soc__tile svg{position:absolute;left:50%;top:50%;width:3rem;height:3rem;color:#fff;transform:translate(-50%,-50%) scale(.8);opacity:0;z-index:1;transition:opacity .5s,transform .6s var(--bb-ease-out,ease)}
  @media(hover:hover){
    #bb-soc-{{ section.id }} .bb-soc__tile:hover img{transform:scale(1.06)}
    #bb-soc-{{ section.id }} .bb-soc__tile:hover::after{opacity:1}
    #bb-soc-{{ section.id }} .bb-soc__tile:hover svg{opacity:1;transform:translate(-50%,-50%) scale(1)}
  }
  @media(max-width:989px){
    #bb-soc-{{ section.id }} .bb-soc__links{grid-template-columns:1fr;gap:1.2rem}
    #bb-soc-{{ section.id }} .bb-soc__link{flex-direction:row;align-items:center;gap:1.6rem;padding:2.2rem 2rem}
    #bb-soc-{{ section.id }} .bb-logo{width:3.6rem;height:3.6rem;flex:none}
    #bb-soc-{{ section.id }} .bb-soc__link>div:first-of-type{flex:1}
    #bb-soc-{{ section.id }} .bb-soc__cta{border:0;padding:0}
    #bb-soc-{{ section.id }} .bb-soc__cta span{display:none}
    #bb-soc-{{ section.id }} .bb-soc__name{font-size:2rem}
    #bb-soc-{{ section.id }} .bb-soc__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
  }
</style>
{%- capture igg -%}igg-{{ section.id }}{%- endcapture -%}
{%- capture ig_logo -%}<svg class="bb-logo bb-logo--ig" viewBox="0 0 24 24" aria-hidden="true"><defs><radialGradient id="{{ igg }}" cx="30%" cy="107%" r="150%"><stop offset="0" stop-color="#FDF497"/><stop offset=".05" stop-color="#FDF497"/><stop offset=".45" stop-color="#FD5949"/><stop offset=".6" stop-color="#D6249F"/><stop offset=".9" stop-color="#285AEB"/></radialGradient></defs><g class="bb-logo__fill" fill="url(#{{ igg }})" fill-rule="evenodd"><path d="M7.2 1.5h9.6a5.7 5.7 0 0 1 5.7 5.7v9.6a5.7 5.7 0 0 1-5.7 5.7H7.2a5.7 5.7 0 0 1-5.7-5.7V7.2a5.7 5.7 0 0 1 5.7-5.7zm0 2A3.7 3.7 0 0 0 3.5 7.2v9.6a3.7 3.7 0 0 0 3.7 3.7h9.6a3.7 3.7 0 0 0 3.7-3.7V7.2a3.7 3.7 0 0 0-3.7-3.7z"/><path d="M12 6.6a5.4 5.4 0 1 1 0 10.8 5.4 5.4 0 0 1 0-10.8zm0 2a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8z"/><circle cx="17.65" cy="6.35" r="1.3"/></g></svg>{%- endcapture -%}
{%- capture yt_logo -%}<svg class="bb-logo bb-logo--yt" viewBox="0 0 24 24" aria-hidden="true"><path class="bb-logo__fill" fill="#FF0000" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8z"/><path class="bb-logo__mark" fill="#fff" d="M9.6 15.6V8.4l6.3 3.6z"/></svg>{%- endcapture -%}
{%- capture tt_logo -%}<svg class="bb-logo bb-logo--tt" viewBox="0 0 24 24" aria-hidden="true"><path class="bb-logo__fill" fill="#111" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>{%- endcapture -%}
{%- capture fb_logo -%}<svg class="bb-logo bb-logo--fb" viewBox="0 0 24 24" aria-hidden="true"><circle class="bb-logo__fill" fill="#1877F2" cx="12" cy="12" r="12"/><path class="bb-logo__mark" fill="#fff" d="M16.67 15.47l.53-3.47h-3.33V9.75c0-.95.47-1.87 1.96-1.87h1.51V4.92s-1.37-.23-2.68-.23c-2.74 0-4.53 1.66-4.53 4.66V12H7.08v3.47h3.05V24a12.1 12.1 0 0 0 3.74 0v-8.53z"/></svg>{%- endcapture -%}
{%- capture ig -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>{%- endcapture -%}
<section class="bb bb-sec bb-sec--{{ section.settings.bg }}" id="bb-soc-{{ section.id }}">
  <div class="bb-wrap">
    <div class="bb-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="bb-soc__links">
      {%- if section.settings.instagram != blank -%}
        <a class="bb-soc__link bb-soc__link--ig bb-card" href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="BeeBlend on Instagram">{{ ig_logo }}<div><div class="bb-soc__name">Instagram</div><div class="bb-soc__handle">{{ section.settings.instagram_handle }}</div></div><div class="bb-soc__cta"><span>Recipes, rituals and new harvests</span><i aria-hidden="true">&rarr;</i></div></a>
      {%- endif -%}
      {%- if section.settings.tiktok != blank -%}
        <a class="bb-soc__link bb-soc__link--tt bb-card" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="BeeBlend on TikTok">{{ tt_logo }}<div><div class="bb-soc__name">TikTok</div><div class="bb-soc__handle">{{ section.settings.tiktok_handle }}</div></div><div class="bb-soc__cta"><span>Recipes and honey moments</span><i aria-hidden="true">&rarr;</i></div></a>
      {%- endif -%}
      {%- if section.settings.youtube != blank -%}
        <a class="bb-soc__link bb-soc__link--yt bb-card" href="{{ section.settings.youtube }}" target="_blank" rel="noopener" aria-label="BeeBlend on YouTube">{{ yt_logo }}<div><div class="bb-soc__name">YouTube</div><div class="bb-soc__handle">{{ section.settings.youtube_handle }}</div></div><div class="bb-soc__cta"><span>From the hive, on film</span><i aria-hidden="true">&rarr;</i></div></a>
      {%- endif -%}
      {%- if section.settings.facebook != blank -%}
        <a class="bb-soc__link bb-soc__link--fb bb-card" href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="BeeBlend on Facebook">{{ fb_logo }}<div><div class="bb-soc__name">Facebook</div><div class="bb-soc__handle">{{ section.settings.facebook_handle }}</div></div><div class="bb-soc__cta"><span>News and offers</span><i aria-hidden="true">&rarr;</i></div></a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="bb-soc__feedhead">
        <h3>{{ section.settings.feed_heading }}</h3>
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Follow {{ section.settings.instagram_handle }}</a>{%- endif -%}
      </div>
      <div class="bb-soc__grid" style="--n: {{ section.blocks.size | at_most: 6 }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <a class="bb-soc__tile bb-card" href="{{ block.settings.link | default: section.settings.instagram }}" target="_blank" rel="noopener" {{ block.shopify_attributes }} aria-label="{{ block.settings.image.alt | default: 'BeeBlend on Instagram' | escape }}">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 50vw', alt: '' }}
              {{ ig }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "BB Social",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the harvest" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Recipes, behind-the-scenes from our beekeepers, and first looks at new honeys." },
    { "type": "text", "id": "instagram", "label": "Instagram URL", "default": "https://www.instagram.com/beeblenduk/" },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@beeblenduk" },
    { "type": "text", "id": "tiktok", "label": "TikTok URL" },
    { "type": "text", "id": "tiktok_handle", "label": "TikTok handle", "default": "@beeblend" },
    { "type": "text", "id": "youtube", "label": "YouTube URL" },
    { "type": "text", "id": "youtube_handle", "label": "YouTube handle" },
    { "type": "text", "id": "facebook", "label": "Facebook URL" },
    { "type": "text", "id": "facebook_handle", "label": "Facebook name", "default": "BeeBlend" },
    { "type": "text", "id": "feed_heading", "label": "Photo grid heading", "default": "From our feed" },
    { "type": "select", "id": "bg", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "paper", "label": "Warm paper" }, { "value": "sage", "label": "Sage" } ] }
  ],
  "blocks": [ { "type": "photo", "name": "Photo", "limit": 6, "settings": [
    { "type": "image_picker", "id": "image", "label": "Lifestyle photo" },
    { "type": "text", "id": "link", "label": "Link (e.g. the Instagram post)" } ] } ],
  "presets": [ { "name": "BB Social" } ]
}
{% endschema %}
