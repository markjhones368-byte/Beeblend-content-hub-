{{ 'bb-premium.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign src = section.settings.collection
  if src == blank and product
    for c in product.collections
      if c.handle != 'all' and c.handle != 'frontpage'
        assign src = c
        break
      endif
    endfor
  endif
  if src == blank
    assign src = collections['all']
  endif
  assign shown = 0
-%}
<section class="bb bb-sec bb-sec--white" id="bb-rel-{{ section.id }}">
  <div class="bb-wrap">
    <div class="bb-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="bb-grid" style="--bb-cols: 4;">
      {%- for p in src.products -%}
        {%- if p.id != product.id and p.available and shown < section.settings.limit -%}
          {% render 'bb-product-card', product: p, quick_add: true %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "BB You may also like",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "collection", "id": "collection", "label": "Collection (blank = same collection as product)" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "BB You may also like" } ]
}
{% endschema %}
