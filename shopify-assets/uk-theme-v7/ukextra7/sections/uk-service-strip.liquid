{%- liquid
  assign sid = 'ukss-' | append: section.id
  assign st = section.settings
-%}
<style>
  #{{ sid }}{background:{{ st.bg }};color:#1F3A2E;padding:{% if st.compact %}2.4rem{% else %}clamp(3.2rem,4vw,4.8rem){% endif %} 0;border-top:1px solid #EFE6D2;border-bottom:1px solid #EFE6D2}
  #{{ sid }} .ukss{list-style:none;margin:0 auto;padding:0 2rem;max-width:132rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.4rem 1.6rem}
  @media(min-width:990px){#{{ sid }} .ukss{grid-template-columns:repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }},minmax(0,1fr));gap:3.2rem}}
  #{{ sid }} .ukss__item{display:flex;align-items:flex-start;gap:1.4rem;min-width:0}
  #{{ sid }} .ukss__ico{flex:none;display:grid;place-items:center;width:4.8rem;height:4.8rem;border-radius:50%;background:#F6E7C1;color:#1F3A2E}
  #{{ sid }} .ukss__ico .uk-ico{width:2.4rem;height:2.4rem}
  #{{ sid }} .ukss__ico .uk-ico circle[fill]{fill:#F6E7C1}
  #{{ sid }} .ukss__t{display:block;font:600 1.55rem/1.3 'Figtree',system-ui,sans-serif;color:#1F3A2E;letter-spacing:.01em}
  #{{ sid }} .ukss__d{display:block;margin-top:.4rem;font:400 1.4rem/1.5 'Figtree',system-ui,sans-serif;color:#6B655B}
  #{{ sid }} a.ukss__item{text-decoration:none}
  #{{ sid }} a.ukss__item:hover .ukss__t{text-decoration:underline;text-underline-offset:.3rem}
  @media(max-width:749px){
    #{{ sid }} .ukss{padding:0 1.6rem;gap:2rem 1.2rem}
    #{{ sid }} .ukss__item{flex-direction:column;gap:1rem}
    #{{ sid }} .ukss__ico{width:4.2rem;height:4.2rem}
    #{{ sid }} .ukss__t{font-size:1.45rem}
    #{{ sid }} .ukss__d{font-size:1.3rem}
  }
</style>
<div class="ukss-sec" id="{{ sid }}">
  <ul class="ukss" role="list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <li {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}<a class="ukss__item" href="{{ b.link }}">{%- else -%}<div class="ukss__item">{%- endif -%}
          <span class="ukss__ico">{% render 'uk-svg', name: b.icon %}</span>
          <span><span class="ukss__t">{{ b.title }}</span>{%- if b.text != blank -%}<span class="ukss__d">{{ b.text }}</span>{%- endif -%}</span>
        {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "UK Service promises",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFCF5" },
    { "type": "checkbox", "id": "compact", "label": "Compact spacing", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Delivery van" }, { "value": "clock", "label": "Clock" }, { "value": "lock", "label": "Padlock" },
          { "value": "box", "label": "Parcel" }, { "value": "refresh", "label": "Replace" }, { "value": "leaf", "label": "Leaf" },
          { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Chat" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery" },
        { "type": "text", "id": "text", "label": "Small text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "UK Service promises", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
